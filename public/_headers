/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(self), accelerometer=(self), gyroscope=(self), magnetometer=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://truyens.metered.live https://0.peerjs.com wss://0.peerjs.com https://*.peerjs.com wss://*.peerjs.com https://ntfy.sh wss://ntfy.sh; manifest-src 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self';

# Vite fingerprints everything under /assets, so it can be cached forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=604800

/logo.webp
  Cache-Control: public, max-age=604800

/og-image.jpg
  Cache-Control: public, max-age=604800

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=3600
